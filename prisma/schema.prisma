// Openchair data model.
//
// Conventions
//  - Money is an Int in the smallest currency unit (cents). Never Float/Decimal.
//  - Every timestamp is timestamptz (UTC). Tenant.timezone (IANA) is used only for display
//    and for turning "9am on Tuesday" into a UTC instant.
//  - Every tenant-owned table carries tenantId. Children reference their parents through
//    COMPOSITE foreign keys (tenantId, parentId) so the database itself rejects a row that
//    points at another tenant's parent. See the README "Multi-tenancy" section.
//  - Auth tables (sessions/accounts) are added in Phase 2 once the auth library is chosen.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  STAFF
}

// Platform-level role, deliberately separate from per-tenant MembershipRole.
enum PlatformRole {
  PLATFORM_ADMIN
}

enum Plan {
  FREE
  PRO
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Tenant {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  timezone           String // IANA, e.g. "America/New_York"
  currency           String   @default("usd")
  plan               Plan     @default(FREE) // denormalised from Subscription; written only by webhooks
  stripeCustomerId   String?  @unique // platform-account customer (Stripe Billing)
  stripeAccountId    String?  @unique // Connect Express account (deposits)
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  detailsSubmitted   Boolean  @default(false)
  depositHoldMinutes Int      @default(15)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  memberships       Membership[]
  services          Service[]
  staff             StaffMember[]
  staffServices     StaffService[]
  availabilityRules AvailabilityRule[]
  timeOff           TimeOff[]
  customers         Customer[]
  bookings          Booking[]
  payments          Payment[]
  subscription      Subscription?
}

// `User`, `Session`, `Account` and `Verification` follow Better Auth's core schema; the
// library reads/writes them. Our additions: platformRole (set only by hand/seed, never by
// sign-up input). Passwords live on Account (providerId = "credential"), not on User.
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  emailVerified Boolean       @default(false)
  image         String?
  platformRole  PlatformRole?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  sessions     Session[]
  accounts     Account[]
  memberships  Membership[]
  staffProfile StaffMember[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String // provider's id for the user ("credential" accounts use the user id)
  providerId            String // "credential" | "google"
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String? // scrypt hash, only for providerId = "credential"
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Service {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  durationMin  Int
  priceCents   Int
  depositCents Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  bookings      Booking[]

  @@unique([id, tenantId]) // target of composite FKs
  @@index([tenantId])
}

model StaffMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String? // set when the barber also has a dashboard login
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffServices     StaffService[]
  availabilityRules AvailabilityRule[]
  timeOff           TimeOff[]
  bookings          Booking[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

// Which staff member performs which service.
model StaffService {
  tenantId  String
  staffId   String
  serviceId String

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff   StaffMember @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  service Service     @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([tenantId])
}

// Weekly recurring hours in the TENANT'S LOCAL wall-clock time.
// startMinute/endMinute are minutes after local midnight (540 = 09:00, 1020 = 17:00).
// dayOfWeek: 0 = Sunday ... 6 = Saturday. Several rows per day allow split shifts.
model AvailabilityRule {
  id          String @id @default(cuid())
  tenantId    String
  staffId     String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, staffId, dayOfWeek])
}

// Absolute UTC instants (a holiday, a sick day), unlike AvailabilityRule.
model TimeOff {
  id       String   @id @default(cuid())
  tenantId String
  staffId  String
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, staffId, startsAt])
}

// A shop's customer. Not a login: customers never create accounts.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
}

// The no-double-booking guarantee lives in SQL, not here: see the migration
// "booking_no_overlap", which adds
//   EXCLUDE USING gist ("staffId" WITH =, tstzrange("startsAt","endsAt") WITH &&)
//   WHERE (status IN ('PENDING_PAYMENT','CONFIRMED'))
// Prisma cannot express exclusion constraints, so it is added as raw SQL.
model Booking {
  id             String        @id @default(cuid())
  tenantId       String
  serviceId      String
  staffId        String
  customerId     String
  startsAt       DateTime      @db.Timestamptz(3)
  endsAt         DateTime      @db.Timestamptz(3)
  status         BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt  DateTime?     @db.Timestamptz(3) // only meaningful while PENDING_PAYMENT
  // Prices are snapshotted so later edits to the Service don't rewrite history.
  priceCents     Int
  depositCents   Int
  publicToken    String        @unique @default(cuid()) // unguessable id for the confirmation URL
  cancelledAt    DateTime?     @db.Timestamptz(3)
  cancelReason   String? // e.g. "hold_expired", "customer", "shop"
  reminderSentAt DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service     @relation(fields: [serviceId, tenantId], references: [id, tenantId])
  staff    StaffMember @relation(fields: [staffId, tenantId], references: [id, tenantId])
  customer Customer    @relation(fields: [customerId, tenantId], references: [id, tenantId])
  payments Payment[]

  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([status, holdExpiresAt]) // expiry sweep
}

model Payment {
  id                      String        @id @default(cuid())
  tenantId                String
  bookingId               String
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String?       @unique
  amountCents             Int
  applicationFeeCents     Int // platform's cut of this deposit
  currency                String
  status                  PaymentStatus @default(PENDING)
  failureReason           String?
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId, tenantId], references: [id, tenantId])

  @@index([tenantId, createdAt])
  @@index([bookingId])
}

model Subscription {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  stripeSubscriptionId String    @unique
  status               String // Stripe status: active, past_due, canceled, ...
  plan                 Plan
  currentPeriodEnd     DateTime? @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Idempotency ledger. The primary key IS Stripe's event id, so inserting the same
// event twice fails with a unique violation, which the handler treats as "already done".
model WebhookEvent {
  id          String    @id // Stripe event id, e.g. evt_...
  source      String // "platform" | "connect"
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  error       String?
}

// Better Auth rate-limit counters (storage: "database"). One row per "<ip>|<path>" key.
// In-memory counters would be useless on Vercel: every serverless instance has its own memory.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt // epoch milliseconds of the last request in the window
}
