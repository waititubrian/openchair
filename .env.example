# ---- Database ----
# Local (docker compose up -d): Postgres on host port 5434.
# Production (Neon): DATABASE_URL is the POOLED string (host contains "-pooler"),
# DIRECT_URL is the non-pooled string, used only by `prisma migrate`.
DATABASE_URL="postgresql://openchair:openchair@localhost:5434/openchair"
DIRECT_URL="postgresql://openchair:openchair@localhost:5434/openchair"

# ---- App ----
APP_URL="http://localhost:3000"

# ---- Auth (Phase 2) ----
AUTH_SECRET=""          # openssl rand -base64 32
# Google sign-in is optional; the button appears only when BOTH are set.
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Authorized redirect URIs:  http://localhost:3000/api/auth/callback/google
#                            https://<your-domain>/api/auth/callback/google   (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Stripe, TEST MODE only (live keys are refused) ----
# Dashboard (test mode) > Developers > API keys.
STRIPE_SECRET_KEY=""             # sk_test_...
# Connected-account events (deposit payments, payout onboarding). Locally, run:
#   stripe listen --forward-connect-to localhost:3000/api/webhooks/stripe-connect
# and paste the whsec_... it prints. In production: Dashboard > Developers > Webhooks,
# "Connected accounts", endpoint <APP_URL>/api/webhooks/stripe-connect, events:
#   account.updated, checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.expired, payment_intent.payment_failed
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET=""         # whsec_... platform endpoint (subscriptions, Phase 6)
STRIPE_PRO_PRICE_ID=""           # price_... of the $19/mo Pro plan (Phase 6)

# ---- Email (Phase 7) ----
RESEND_API_KEY=""
EMAIL_FROM="Openchair <onboarding@resend.dev>"

# ---- Cron ----
# Secret for /api/cron/expire-holds. Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it the endpoint refuses every request.  openssl rand -base64 32
CRON_SECRET=""
