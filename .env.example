# ---- Database ----
# Local (docker compose up -d): Postgres on host port 5434.
# Production (Neon): DATABASE_URL is the POOLED string (host contains "-pooler"),
# DIRECT_URL is the non-pooled string, used only by `prisma migrate`.
DATABASE_URL="postgresql://openchair:openchair@localhost:5434/openchair"
DIRECT_URL="postgresql://openchair:openchair@localhost:5434/openchair"

# ---- App ----
APP_URL="http://localhost:3000"

# ---- Auth (Phase 2) ----
AUTH_SECRET=""          # openssl rand -base64 32
# Google sign-in is optional; the button appears only when BOTH are set.
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Authorized redirect URIs:  http://localhost:3000/api/auth/callback/google
#                            https://<your-domain>/api/auth/callback/google   (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- M-Pesa (Safaricom Daraja). SANDBOX ONLY: "production" is refused. ----
# Quick start with NO Safaricom account: MPESA_MODE="simulator" (development only; refused in production).
#   Test numbers: 0700000001 cancels the prompt, 0700000002 has no funds, 0700000003 never answers,
#   0700000004 wrong PIN; any other number approves after ~2 seconds.
# Real sandbox: create an app at https://developer.safaricom.co.ke, then set MPESA_MODE="daraja" and the
#   four credentials below. Safaricom must reach the callback over public HTTPS, so locally run a tunnel
#   (ngrok / cloudflared) and put its https origin in MPESA_CALLBACK_BASE_URL.
MPESA_MODE=""                    # "simulator" | "daraja"
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""               # sandbox: 174379
MPESA_PASSKEY=""                 # from the Daraja portal (Lipa Na M-Pesa Online)
MPESA_CALLBACK_BASE_URL=""       # public https origin; defaults to APP_URL
# Callbacks are NOT signed, so the callback URL carries this secret: <base>/api/webhooks/mpesa/<secret>
# 16+ characters.  openssl rand -hex 16
MPESA_CALLBACK_SECRET=""

# ---- Email (Phase 7) ----
RESEND_API_KEY=""
EMAIL_FROM="Openchair <onboarding@resend.dev>"

# ---- Cron ----
# Secret for /api/cron/expire-holds. Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it the endpoint refuses every request.  openssl rand -base64 32
CRON_SECRET=""
